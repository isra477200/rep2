{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "node scripts/stamp-build-date.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run ads:patterns:test",
    "ads:coverage": "node scripts/build-ad-coverage.mjs",
    "ads:corpus": "node scripts/build-ad-corpus.mjs",
    "ads:ocr": "node scripts/run-ad-ocr.mjs",
    "ads:ocr:prepare": "node scripts/prepare-ad-ocr-source.mjs",
    "ads:ocr:audit-structured": "node scripts/update-ad-ocr-audit-from-structured-copy.mjs",
    "ads:translate": "node scripts/build-ad-translations.mjs",
    "ads:translations:merge": "node scripts/merge-ad-translation-overrides.mjs",
    "ads:build": "node scripts/build-ad-coverage.mjs && node scripts/build-ad-corpus.mjs && node scripts/build-ad-coverage.mjs && node scripts/build-data-manifest.mjs",
    "ads:identity": "node scripts/snapshot-ad-media-identity.mjs",
    "data:manifest": "node scripts/build-data-manifest.mjs",
    "data:details": "node scripts/normalize-company-details.mjs",
    "sites:manifests": "node scripts/build-site-capture-manifests.mjs",
    "sites:enrich": "node scripts/enrich-site-capture-copy.mjs",
    "sites:optimize": "node scripts/optimize-site-capture-images.mjs",
