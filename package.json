    "scrapecreators:media:download": "node scripts/download-scrapecreators-media.mjs",
    "scrapecreators:media:publish": "node scripts/publish-scrapecreators-media.mjs",
    "scrapecreators:sites:init": "node scripts/init-scrapecreators-site-captures.mjs",
    "scrapecreators:sites:synthesize": "node scripts/synthesize-scrapecreators-site-captures.mjs",
    "serpapi:plan": "node scripts/serpapi-google-ads-runner.mjs --dry-run",
    "serpapi:run": "node scripts/serpapi-google-ads-runner.mjs --execute",
    "serpapi:normalize": "node scripts/normalize-serpapi-google-ads.mjs",
    "serpapi:companies": "node scripts/integrate-serpapi-companies.mjs",
    "serpapi:media": "node scripts/download-serpapi-media.mjs",
    "leads-market:import": "node scripts/import-leads-market-html.mjs",
    "leads-market:companies": "node scripts/integrate-leads-market-companies.mjs",
    "leads-market:qa": "node --test tests/leads-market-import.test.mjs",
    "media:normalize": "node scripts/normalize-media.mjs",
    "gallery:index": "node scripts/build-gallery-index.mjs",
    "geo:build": "node scripts/build-country-geo.mjs",
    "logos:build": "node scripts/download-logos.mjs",
    "logos:recover": "node scripts/recover-browser-logos.mjs",
    "logos:tones": "node scripts/build-logo-tones.mjs",
    "logos:sync": "node scripts/sync-logo-quality.mjs && node scripts/build-data-manifest.mjs",
    "logos:qa": "node --test tests/logo-integrity.test.mjs",
    "audit:portal": "node scripts/update-portal-audit.mjs",
    "research:init": "node scripts/init-deep-research.mjs",
    "research:reset": "node scripts/reset-deep-collection.mjs",
    "research:collect": "node scripts/collect-deep-research.mjs",
    "research:normalize": "node scripts/normalize-deep-research.mjs",
    "research:synthesize": "node scripts/synthesize-deep-research.mjs",
    "research:manual": "node scripts/apply-manual-research.mjs",
    "research:classify": "node scripts/apply-classification-review.mjs",
    "research:audit": "node scripts/audit-deep-research.mjs",
    "research:qa": "node scripts/qa-deep-research.mjs",
    "research:v3:init": "node scripts/init-funnel-v3.mjs",
    "research:v3:render": "node scripts/render-funnel-v3.mjs --pages 10 --concurrency 3 --retries 3",
    "research:v3:audit-rendered": "node scripts/audit-rendered-v3.mjs",
    "research:v3:select-repair": "node scripts/select-render-repair-v3.mjs",
    "research:v3:synthesize": "node scripts/synthesize-funnel-v3.mjs",
    "research:v3:qa": "node scripts/qa-funnel-v3.mjs --apply --strict",
    "research:v3:publish": "node scripts/publish-funnel-v3.mjs",
    "research:v3:notion-plan": "node scripts/build-notion-v3-plan.mjs",
    "research:v3:notion-read": "node scripts/read-notion-v3-plan.mjs",
    "audit:final": "node scripts/update-final-audit.mjs --strict",
    "smoke:records": "node scripts/smoke-record-pages.mjs",
    "geo:companies": "node scripts/build-company-geo.mjs",
    "editorial:public": "node scripts/generate-public-editorial.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@huggingface/transformers": "^3.8.1",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cheerio": "1.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "franc-min": "^6.2.0",
    "globals": "16.4.0",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.35.3",
    "tailwindcss": "4.2.1",
    "tesseract.js": "^7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "world-countries": "5.1.0",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
