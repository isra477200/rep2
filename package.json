    "sites:prepare:deployment:previews": "node scripts/prepare-site-deployment-previews.mjs",
    "sites:audit:deployment": "node scripts/audit-site-deployment-staging.mjs",
    "sites:prepare:deployment:documents": "python scripts/prepare_site_deployment_documents.py",
    "sites:compact:deployment": "node scripts/compact-site-deployment-data.mjs",
    "sites:recompress:deployment": "node scripts/recompress-site-deployment-staging.mjs",
    "sites:finalize:deployment": "node scripts/finalize-site-deployment-staging.mjs",
    "sites:package:qa": "node --test tests/site-deployment-packaging.test.mjs",
    "sites:qa": "node --test tests/site-captures-contract.test.mjs tests/site-capture-copy-enrichment.test.mjs",
    "landings:intelligence": "node scripts/build-landing-intelligence.mjs",
    "landings:qa": "node --experimental-strip-types --test tests/landing-studio.test.mjs",
    "decisions:build": "node scripts/build-competitive-intelligence.mjs && node scripts/build-ad-landing-audit.mjs",
    "decisions:qa": "node --experimental-strip-types --test tests/competitive-intelligence.test.mjs tests/ad-landing-audit.test.mjs tests/landing-studio.test.mjs",
    "growth:qa": "node --experimental-strip-types --test tests/growth-workflow.test.mjs tests/competitive-intelligence.test.mjs tests/ad-landing-audit.test.mjs tests/landing-studio.test.mjs tests/ad-pattern-engine.test.mjs",
    "ads:qa": "node --experimental-strip-types --test tests/ad-corpus.test.mjs tests/ad-intelligence.test.mjs tests/ad-language.test.mjs tests/ad-pattern-engine.test.mjs tests/leads-market-import.test.mjs tests/serpapi-google-ads.test.mjs",
    "ads:patterns:test": "node --experimental-strip-types --test tests/ad-pattern-engine.test.mjs",
    "scrapecreators:normalize": "node scripts/normalize-scrapecreators-ads.mjs",
